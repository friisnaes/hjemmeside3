// ─── STATE ───────────────────────────────────────────────────────────────────
let currentDay = 0;
let completed = JSON.parse(localStorage.getItem('kc_done') || '[]');

// ─── INIT ────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('yr').textContent = new Date().getFullYear();
  renderChallenge(0);
  buildTracker();
  updateStats();

  // Show nav label after scroll
  window.addEventListener('scroll', () => {
    const label = document.getElementById('nav-day-label');
    if (window.scrollY > 200) {
      label.textContent = `— Dag ${currentDay + 1}`;
      label.classList.add('visible');
    } else {
      label.classList.remove('visible');
    }
  });
});

// ─── CHALLENGE RENDERER ──────────────────────────────────────────────────────
function renderChallenge(idx) {
  currentDay = idx;
  const c = challenges[idx];

  document.getElementById('c-day-label').textContent = `Dag ${c.day} · ${c.category}`;
  document.getElementById('c-action').textContent = c.action;
  document.getElementById('c-reflection').textContent = c.reflection;

  document.getElementById('btn-prev').disabled = idx === 0;
  document.getElementById('btn-next').disabled = idx === challenges.length - 1;

  const pct = ((idx + 1) / challenges.length) * 100;
  document.getElementById('progress-fill').style.width = pct + '%';
}

function changeDay(dir) {
  const next = currentDay + dir;
  if (next < 0 || next >= challenges.length) return;
  renderChallenge(next);
}

// ─── TRACKER ─────────────────────────────────────────────────────────────────
function buildTracker() {
  const grid = document.getElementById('tracker-grid');
  grid.innerHTML = '';
  for (let i = 0; i < 30; i++) {
    const cell = document.createElement('div');
    cell.className = 'tracker-day' + (completed.includes(i) ? ' done' : '');
    cell.dataset.idx = i;
    cell.innerHTML = `<span class="tracker-day-num">${i + 1}</span>`;
    cell.addEventListener('click', () => toggleDay(i));
    grid.appendChild(cell);
  }
}

function toggleDay(idx) {
  if (completed.includes(idx)) {
    completed = completed.filter(d => d !== idx);
  } else {
    completed.push(idx);
  }
  localStorage.setItem('kc_done', JSON.stringify(completed));
  buildTracker();
  updateStats();
}

function updateStats() {
  const done = completed.length;
  document.getElementById('stat-done').textContent = done;
  document.getElementById('stat-left').textContent = 30 - done;
  document.getElementById('stat-pct').textContent = Math.round((done / 30) * 100) + '%';
}

function resetProgress() {
  if (!confirm('Nulstil al fremgang? Dette kan ikke fortrydes.')) return;
  completed = [];
  localStorage.removeItem('kc_done');
  buildTracker();
  updateStats();
}
